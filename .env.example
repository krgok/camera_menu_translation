# Client-side (Vite exposes VITE_* vars to the browser; safe to expose — protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by api/*.ts, never exposed to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=

# Optional: comma-separated emails allowed to use the paid APIs
# (e.g. "me@gmail.com,friend@gmail.com"). Empty = any logged-in user.
ALLOWED_EMAILS=

# Daily quota for the paid APIs (see supabase/migrations/004_api_usage_quota.sql).
# QUOTA_SECRET must equal the 'quota_secret' row you insert into
# menu_camera_quota_config (a long random string; never commit the real value).
# Unset = per-instance in-memory fallback only (weaker).
QUOTA_SECRET=
# Optional overrides (calls per UTC day). Defaults: analyze 40/400,
# explain 150/1500, explain_batch 30/200 (per user / whole service).
# DAILY_LIMIT_ANALYZE= DAILY_LIMIT_EXPLAIN= DAILY_LIMIT_EXPLAIN_BATCH=
# GLOBAL_DAILY_LIMIT_ANALYZE= GLOBAL_DAILY_LIMIT_EXPLAIN= GLOBAL_DAILY_LIMIT_EXPLAIN_BATCH=
